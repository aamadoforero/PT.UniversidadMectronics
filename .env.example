# Copie este archivo como .env y ajuste la cadena de conexión a su SQL Server.
# Desde los contenedores, el SQL Server instalado en su equipo se llama host.docker.internal.
CADENA_CONEXION=Server=host.docker.internal,1433;Database=UniversidadMectronics;User Id=sa;Password=SuContrasena;TrustServerCertificate=True
