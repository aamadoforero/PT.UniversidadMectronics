      ]
    },
    {
      "name": "5. Claves",
      "description": "Clave pública para que otros microservicios validen los tokens.",
      "item": [
        {
          "name": "Clave pública (JWKS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Clave pública RSA en formato JWKS. Es anónima y nunca incluye la parte privada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
