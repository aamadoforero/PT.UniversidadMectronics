{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LimiteSolicitudes": {
    "PermitidasPorMinuto": 300
  },
  "ReverseProxy": {
    "Routes": {
      "seguridad": {
        "ClusterId": "seguridad",
        "Match": { "Path": "/api/seguridad/{**resto}" }
      },
      "claves-publicas": {
        "ClusterId": "seguridad",
        "Match": { "Path": "/.well-known/{**resto}" }
      },
      "academico": {
        "ClusterId": "academico",
        "Match": { "Path": "/api/academico/{**resto}" }
      }
    },
    "Clusters": {
      "seguridad": {
        "Metadata": { "Nombre": "Seguridad" },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "principal": { "Address": "http://localhost:5090" }
        }
      },
      "academico": {
        "Metadata": { "Nombre": "Académico" },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "principal": { "Address": "http://localhost:5091" }
        }
      }
    }
  }
}
